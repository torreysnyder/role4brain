-def compute_target_stats(data):
-    """Compute mean and std over target_encoding features."""
+def compute_target_stats(data, scaling="per_dim"):
+    """Compute mean and scale over target_encoding features.
+
+    scaling="per_dim" divides every dimension by its own SD. On PCA targets that
+    whitens them: each component gets equal weight in the loss whatever its
+    variance, so low-variance, mostly-noise components weigh as much as the
+    first. scaling="global" divides every dimension by one shared scale (the
+    root mean variance), which keeps the components' relative weights and makes
+    the loss proportional to vertex-space MSE. See
+    multisubject_handoff/TARGETS_AND_WHITENING.md.
+    """
     with torch.no_grad():
         xs = [inst.target_encoding.view(-1).cpu().numpy() for inst in data]
         X = np.stack(xs, axis=0)
         mu = torch.from_numpy(X.mean(axis=0)).float()
-        sigma = torch.from_numpy(X.std(axis=0) + 1e-6).float()
+        if scaling == "per_dim":
+            sigma = torch.from_numpy(X.std(axis=0) + 1e-6).float()
+        elif scaling == "global":
+            scale = float(np.sqrt(X.var(axis=0).mean())) + 1e-6
+            sigma = torch.full_like(mu, scale)
+        else:
+            raise ValueError(f"unknown target scaling {scaling!r}")
     return mu, sigma
 
 
